{
  "timezone": "Europe/Paris",
  "runtime": {
    "repo": "https://github.com/<owner>/claudio",
    "tag": "<release-tag>",
    "sha": "<40-hex-sha>"
  },
  "places": {
    "cloud": {
      "runtime_dir": "/<cloud-parent-dir>/claudio-runtime",
      "state_dir": "/<cloud-private-repo-dir>"
    },
    "local": {
      "runtime_dir": "/<local-parent-dir>/claudio-runtime",
      "state_dir": "/<local-private-repo-dir>"
    }
  },
  "providers": {
    "observability": {
      "adapter": "<observability-adapter>",
      "api": {
        "base_url": "https://<observability-api-host>",
        "credentials": {
          "api_key": "OBSERVABILITY_API_KEY",
          "app_key": "OBSERVABILITY_APP_KEY"
        }
      },
      "mcp": {
        "connectors": {
          "cloud": "<observability-connector-name>",
          "local": "<observability-connector-name>"
        }
      }
    },
    "document-store": {
      "adapter": "<document-store-adapter>",
      "api": {
        "base_url": "https://<document-store-api-host>",
        "credentials": {
          "token": "DOCUMENT_STORE_TOKEN"
        }
      },
      "mcp": {
        "connectors": {
          "cloud": "<document-store-connector-name>",
          "local": "<document-store-connector-name>"
        }
      }
    }
  },
  "values": {
    "chat": {
      "digest_channel_id": "<chat-channel-id>"
    }
  },
  "routines": {
    "prod-watch": {
      "id": "<routine-id>",
      "template": "prod-watch",
      "cron": "CRON_TZ=Europe/Paris 30 9,13,17 * * 1-5",
      "sources": {
        "monitors": {
          "provider": "observability",
          "transport": {
            "cloud": "api",
            "local": "api"
          },
          "kind": "monitors",
          "scope_filter": "<alert-event-query>",
          "discovery_query": "<monitor-search-query>"
        },
        "metrics": {
          "provider": "observability",
          "transport": {
            "cloud": "api",
            "local": "api"
          },
          "kind": "metrics",
          "scope_filter": ""
        },
        "sources-page": {
          "provider": "document-store",
          "transport": {
            "cloud": "api",
            "local": "mcp"
          },
          "page_id": "<document-page-id>"
        }
      },
      "rules": [
        "<routine-rule-for-flapping-monitors>",
        "<routine-rule-for-discovered-monitors>",
        "<routine-rule-for-monitors-without-data>"
      ],
      "query_pack": [
        {
          "key": "monitor-1234",
          "source": "monitors",
          "title": "<monitor-title>",
          "link": "<monitor-link>",
          "rule": "<rule-for-this-monitor>",
          "schedule": "every_run",
          "monitor": "1234"
        },
        {
          "key": "<hourly-metric-key>",
          "source": "metrics",
          "title": "<hourly-metric-title>",
          "link": "<hourly-metric-link>",
          "rule": "<rule-for-this-metric>",
          "schedule": "every_run",
          "query": "<hourly-metric-query>",
          "read": "hourly",
          "aggregator": "<aggregator>",
          "excluded_hours": [2, 3]
        },
        {
          "key": "<daily-metric-key>",
          "source": "metrics",
          "title": "<daily-metric-title>",
          "link": "<daily-metric-link>",
          "rule": "<rule-for-this-metric>",
          "schedule": "daily",
          "query": "<daily-metric-query>",
          "read": "scalar",
          "aggregator": "<aggregator>",
          "lookback_days": 7
        }
      ],
      "models": {
        "digest": "<model-id>"
      }
    }
  }
}
